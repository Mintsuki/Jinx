do_build() {
    eval "$(include_recipe "${base_dir}"/recipes/$1)"

    mkdir -p "${build_dir}"/builds/${name}

    if [[ -n ${from_source} || -n ${tarball_url} || -n ${git_url} || -n ${source_dir} ]]; then
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
            local source_dir="$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$source_dir")"
        else
            local from_source=${name}
        fi

        if [[ -z ${source_dir} ]]; then
            local source_dir="${base_dir}"/${_sources_root}/${from_source}
        else
            local source_dir="${base_dir}"/"${source_dir}"
        fi
    fi

    local prefix="/usr"
    local sysroot="/sysroot"

    cd "${build_dir}"/builds/${name}
    build
    cd "${base_dir}"
}

do_package() {
    eval "$(include_recipe "${base_dir}"/recipes/$1)"

    local dest_dir="${build_dir}/pkgs/${name}"

    force_remove "${dest_dir}"
    mkdir -p "${dest_dir}"

    if [[ -n ${from_source} || -n ${tarball_url} || -n ${git_url} || -n ${source_dir} ]]; then
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
            local source_dir="$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$source_dir")"
        else
            local from_source=${name}
        fi

        if [[ -z ${source_dir} ]]; then
            local source_dir="${base_dir}"/${_sources_root}/${from_source}
        else
            local source_dir="${base_dir}"/"${source_dir}"
        fi
    fi

    local prefix="/usr"
    local sysroot="/sysroot"

    mkdir -p "${dest_dir}${prefix}"

    cd "${build_dir}"/builds/${name}
    package

    # Remove libtool files
    find "${dest_dir}${prefix}" -name "*.la" -exec rm -rvf {} +

    cd "${base_dir}"
}

source_is_pinned() {
    # Does any recipe sharing source $1 (rooted at $2) keep its build directory?
    # Such a directory was configured out of tree and still names the source as
    # srcdir, so reaping it would leave the tree unusable. Only a recipe assigning
    # clean_workdirs keeps one, which is what grep narrows to.
    local _src="$1"
    local _root="$2"

    local _rec _id
    for _rec in "${base_dir}"/recipes/*/recipe "${base_dir}"/host-recipes/*/recipe; do
        [[ -f ${_rec} ]] && grep -q 'clean_workdirs' "${_rec}" || continue

        _id=$(
            eval "$(include_recipe "${_rec%/recipe}")"
            [[ ${clean_workdirs} == no ]] || exit 0
            echo "${_sources_root}/${from_source:-${name}}"
        )

        if [[ ${_id} == "${_root}/${_src}" ]]; then
            return 0
        fi
    done

    return 1
}

clean_sources() {
    force_remove "${base_dir}"/${_sources_root}/$1
    force_remove "${base_dir}"/${_sources_root}/$1-clean
    force_remove "${base_dir}"/${_sources_root}/$1-workdir
    force_remove "${base_dir}"/${_sources_root}/$1.version
    force_remove "${base_dir}"/${_sources_root}/$1.patched
    force_remove "${base_dir}"/${_sources_root}/$1.prepared
    force_remove "${base_dir}"/${_sources_root}/$1.revision
    force_remove "${base_dir}"/${_sources_root}/$1.host-revision
}

do_source() {
    eval "$(source_source_recipe "$1" "$2")"

    # Only ever called on the recipe that owns a source.
    if [[ -n ${from_source} ]]; then
        die "recipe '$1' cannot provide sources to other recipes, as it takes its own through from_source/from_host_source"
    fi

    eval "$(get_real_source_dir)"

    local cross_compile=yes
    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_sources_ro=
    local container_base_dir_ro=
    prepare_container

    local _need_fetch=no
    if [[ ! -f "${base_dir}/${_sources_root}/$1.version" || $(cat "${base_dir}/${_sources_root}/$1.version") != "${version}" ]]; then
        local _need_fetch=yes
    fi
    # Re-clone a managed clone whose working tree was removed, even if .version matches.
    if [[ ${is_local_package} == true && -n ${git_url} && ! -d ${source_dir} ]]; then
        local _need_fetch=yes
    fi
    if [[ ${_need_fetch} == yes ]]; then
        if [[ ${is_local_package} != true ]]; then
            msg2 "Fetching the source of $1"
        elif [[ -n ${git_url} && ! -d ${source_dir} ]]; then
            msg2 "Cloning the source of $1"
        fi
        tracked_subshell '
            local allow_network=yes
            local container_base_dir_ro=
            clean_sources '$1'
            [[ ${is_local_package} == true ]] \
                || [[ -n ${tarball_sha256} && ${tarball_sha256} == "?" ]] \
                || [[ -n ${tarball_sha512} && ${tarball_sha512} == "?" ]] \
                || [[ -n ${tarball_blake2b} && ${tarball_blake2b} == "?" ]] \
                || local container_base_dir_ro=yes
            run_in_container internal-fetch '$1' '$2'
            echo "${version}" >"${base_dir}"/${_sources_root}/'$1'.version
        '
    fi

    if [[ ! -f "${base_dir}/${_sources_root}/$1.patched" ]]; then
        if [[ ${is_local_package} != true && -d ${recipe_dir}/patches ]]; then
            msg2 "Applying patches to $1"
        fi
        tracked_subshell '
            if [[ ${is_local_package} != true && ${is_sourceless_package} != true ]]; then
                local allow_network=yes
                run_in_container internal-patch '$1' '$2'
            fi
            touch "${base_dir}"/${_sources_root}/'$1'.patched
        '
    fi

    if [[ ! -f "${base_dir}/${_sources_root}/$1.prepared" ]]; then
        if [[ ${is_sourceless_package} != true ]]; then
            msg2 "Running prepare() for $1"
        fi
        tracked_subshell '
            local container_base_dir_ro=
            if [[ ${is_sourceless_package} != true ]]; then
                [[ ${is_local_package} == true ]] || local container_base_dir_ro=yes
                run_in_container internal-prepare '$1' '$2'
            fi
            touch "${base_dir}"/${_sources_root}/'$1'.prepared
        '
    fi

    destroy_container
}

do_rebuild() {
    force_remove "${build_dir}"/builds/"$1"

    do_pkg "$1"
}

do_host_rebuild() {
    force_remove "${build_dir}"/host-builds/"$1"

    do_host_pkg "$1"
}

do_regen() {
    eval "$(source_source_recipe "$1" "$2")"

    if [[ -n ${from_source} ]]; then
        if [[ ${_from_source_dir} == host-recipes ]]; then
            die "recipe '$1' uses from_source/from_host_source; regen its source with: $0 regen host:${from_source}"
        else
            die "recipe '$1' uses from_source/from_host_source; regen its source with: $0 regen ${from_source}"
        fi
    fi
    [[ -f "${base_dir}/${_sources_root}/$1.patched" ]] || die "cannot regenerate non-built package"

    eval "$(get_real_source_dir)"

    make_temp
    local patch_file="${tmp}"

    if [[ ${is_local_package} != true ]]; then
        cd "${base_dir}/${_sources_root}"

        # exclude version control dirs
        make_temp -d
        local vc_dir_clean="${tmp}"
        force_remove "${vc_dir_clean}"
        make_temp -d
        local vc_dir_workdir="${tmp}"
        force_remove "${vc_dir_workdir}"

        if [[ -n ${git_url} ]]; then
            mv $1-clean/.git "${vc_dir_clean}"
            mv $1-workdir/.git "${vc_dir_workdir}"
        fi

        git diff --no-index --no-prefix $1-clean $1-workdir >"${patch_file}" || true

        if [[ -n ${git_url} ]]; then
            mv "${vc_dir_clean}" $1-clean/.git
            mv "${vc_dir_workdir}" $1-workdir/.git
        fi

        local _regen_patches_dir="${base_dir}/${_from_source_dir}/$1/patches"
        if [[ -s "${patch_file}" ]]; then
            mkdir -p "${_regen_patches_dir}"
            mv "${patch_file}" "${_regen_patches_dir}/jinx-working-patch.patch"
        else
            rm -f "${_regen_patches_dir}/jinx-working-patch.patch"
            rmdir "${_regen_patches_dir}" 2>/dev/null || true
        fi

        cd "${base_dir}"

        force_remove "${source_dir}"
        cp -rp "${base_dir}"/${_sources_root}/$1-workdir "${source_dir}"
    fi

    force_remove "${base_dir}"/${_sources_root}/$1.prepared

    local cross_compile=yes
    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_sources_ro=
    local container_base_dir_ro=
    prepare_container
    run_in_container internal-prepare "$1" "$2"
    destroy_container

    touch "${base_dir}"/${_sources_root}/$1.prepared
}

do_host_pkg() {
    eval "$(include_recipe "${base_dir}"/host-recipes/$1)"

    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    msg "Building host:${name} ${version}_${revision}"

    if [[ ! -f "${build_dir}/host-pkgs/${name}-${version}_${revision}.${host_arch}.xbps" ]]; then
        force_remove "${build_dir}"/host-builds/"$1"
        if [[ -z ${from_source} ]] \
           && [[ -f "${base_dir}/${_sources_root}/$1.host-revision" ]] \
           && [[ $(cat "${base_dir}/${_sources_root}/$1.host-revision") != "${revision}" ]]; then
            tracked_subshell 'clean_sources "${name}"'
        fi
    fi

    if [[ -n ${from_source} ]]; then
        tracked_subshell 'do_source "${from_source}" "${_from_source_dir}"'
    else
        tracked_subshell 'do_source "${name}" host-recipes'
    fi

    echo "${revision}" >"${base_dir}"/${_sources_root}/$1.host-revision

    local cross_compile=yes
    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_base_dir_ro=
    prepare_container

    local container_sources_ro=yes
    if [[ ! -d "${build_dir}/host-builds/$1" ]]; then
        msg2 "Running configure()"
        run_in_container internal-configure-host $1
    fi
    msg2 "Running build()"
    run_in_container internal-build-host $1
    force_remove "${build_dir}"/host-pkgs/$1
    msg2 "Running package()"
    run_in_container internal-package-host $1

    destroy_container

    local xbps_deps=""
    local hostrundep
    for hostrundep in ${hostrundeps}; do
        local xbps_deps="${xbps_deps} ${hostrundep}>=0.0"
    done

    local dest_dir="${build_dir}/host-pkgs/${name}"

    msg2 "Creating the package"
    cd "${build_dir}"/host-pkgs
        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${host_arch}" \
    xbps-create \
        -A ${host_arch} \
        -s ${name} \
        -n ${name}-${version}_${revision} \
        -D "${xbps_deps}" \
        -F "${conf_files}" \
        "${dest_dir}"

    force_remove "${dest_dir}"

        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${host_arch}" \
    xbps-rindex \
        -a "${build_dir}"/host-pkgs/${name}-${version}_${revision}.${host_arch}.xbps \
        -f

    if [[ ${JINX_CLEAN_WORKDIRS} == yes ]]; then
        if [[ ${clean_workdirs} != no ]]; then
            force_remove "${build_dir}"/host-builds/$1

            # Only the recipe that owns a source may reap it; a from_source
            # recipe borrows a tree the owner and other borrowers still need.
            if [[ -z ${from_source} ]]; then
                eval "$(source_source_recipe "$1" host-recipes)"

                eval "$(get_real_source_dir)"

                if [[ ${is_sourceless_package} != true && ${is_local_package} != true ]] \
                   && ! source_is_pinned "${name}" "${_sources_root}"; then
                    clean_sources "${name}"
                fi
            fi
        fi
    fi
}

do_pkg() {
    eval "$(include_recipe "${base_dir}"/recipes/$1)"

    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    msg "Building ${name} ${version}_${revision}"

    if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
        force_remove "${build_dir}"/builds/"$1"
        if [[ -z ${from_source} ]] \
           && [[ -f "${base_dir}/${_sources_root}/$1.revision" ]] \
           && [[ $(cat "${base_dir}/${_sources_root}/$1.revision") != "${revision}" ]]; then
            tracked_subshell 'clean_sources "${name}"'
        fi
    fi

    if [[ -n ${from_source} ]]; then
        tracked_subshell 'do_source "${from_source}" "${_from_source_dir}"'
    else
        tracked_subshell 'do_source "${name}" recipes'
    fi

    echo "${revision}" >"${base_dir}"/${_sources_root}/$1.revision

    local container_pkgs=
    local sysroot=
    local imgroot=
    local container_base_dir_ro=
    prepare_container

    local container_sources_ro=yes
    if [[ ! -d "${build_dir}/builds/$1" ]]; then
        msg2 "Running configure()"
        run_in_container internal-configure $1
    fi
    msg2 "Running build()"
    run_in_container internal-build $1
    force_remove "${build_dir}"/pkgs/$1
    msg2 "Running package()"
    run_in_container internal-package $1

    destroy_container

    local xbps_deps=""
    local dep _dep_bootstrap
    for dep in ${deps}; do
        _dep_bootstrap=$(eval "$(include_recipe "${base_dir}"/recipes/${dep})" && echo "${bootstrap_pkg}")
        if [[ ${_dep_bootstrap} == yes ]]; then
            continue
        fi

        local xbps_deps="${xbps_deps} ${dep}>=0.0"
    done

    local binpkgdep
    for binpkgdep in ${binpkgdeps}; do
        [[ -f "${base_dir}/recipes/${binpkgdep}/recipe" ]] \
            || die "binpkgdeps entry '${binpkgdep}' of recipe '${name}' is not a recipe"

        local _dupe
        for _dupe in ${deps} ${builddeps}; do
            if [[ ${binpkgdep} == "${_dupe}" ]]; then
                die "recipe '${name}' lists '${binpkgdep}' in both binpkgdeps and deps/builddeps; binpkgdeps is only for a runtime dependency whose build-order edge would otherwise create a cycle"
            fi
        done

        _dep_bootstrap=$(eval "$(include_recipe "${base_dir}"/recipes/${binpkgdep})" && echo "${bootstrap_pkg}")
        if [[ ${_dep_bootstrap} == yes ]]; then
            continue
        fi

        local xbps_deps="${xbps_deps} ${binpkgdep}>=0.0"
    done

    local dest_dir="${build_dir}/pkgs/${name}"

    msg2 "Creating the package"
    cd "${build_dir}"/pkgs
        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
    xbps-create \
        -A $JINX_ARCH \
        -s ${name} \
        -n ${name}-${version}_${revision} \
        -D "${xbps_deps}" \
        -F "${conf_files}" \
        "${dest_dir}"

    force_remove "${dest_dir}"

        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
    xbps-rindex \
        -a "${build_dir}"/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps \
        -f

    if [[ ${JINX_CLEAN_WORKDIRS} == yes ]]; then
        if [[ ${clean_workdirs} != no ]]; then
            force_remove "${build_dir}"/builds/$1

            # Only the recipe that owns a source may reap it; a from_source
            # recipe borrows a tree the owner and other borrowers still need.
            if [[ -z ${from_source} ]]; then
                eval "$(source_source_recipe "$1" recipes)"

                eval "$(get_real_source_dir)"

                if [[ ${is_sourceless_package} != true && ${is_local_package} != true ]] \
                   && ! source_is_pinned "${name}" "${_sources_root}"; then
                    clean_sources "${name}"
                fi
            fi
        fi
    fi
}

cmd_build() {
    local ppkg
    for ppkg in "$@"; do
        local pkg
        if [[ ${ppkg} == host:* ]]; then
            for pkg in $(cd "${base_dir}/host-recipes" && echo ${ppkg#host:}); do
                tracked_subshell 'do_host_pkg "${pkg}"'
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
                tracked_subshell 'do_pkg "${pkg}"'
            done
        fi
    done
}

do_build_if_needed() {
    eval "$(include_recipe "${base_dir}"/recipes/$1)"
    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
        tracked_subshell 'do_pkg "'$1'"'
    fi
}

host_pkg_filename() {
    eval "$(include_recipe "${base_dir}"/host-recipes/$1)"
    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi
    echo "${name}-${version}_${revision}.${host_arch}.xbps"
}

do_host_build_if_needed() {
    eval "$(include_recipe "${base_dir}"/host-recipes/$1)"
    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    if [[ ! -f "${build_dir}/host-pkgs/${name}-${version}_${revision}.${host_arch}.xbps" ]]; then
        tracked_subshell 'do_host_pkg "'$1'"'
    fi
}

pkg_previously_built() {
    # Has package $1 ever been built into directory $2 for arch $3? A bare
    # '$1-*_*' glob would also match packages merely prefixed with '$1-', so
    # require what precedes the revision to be a version, which has no '-'.
    local pkg="$1"
    local dir="$2"
    local arch="$3"

    local file
    for file in "${dir}/${pkg}"-*_*."${arch}".xbps; do
        [[ -f ${file} ]] || continue

        local name_version="${file##*/}"
        local name_version="${name_version%".${arch}.xbps"}"
        local name_version="${name_version%_*}"

        if [[ ${name_version#"${pkg}-"} != *-* ]]; then
            return 0
        fi
    done

    return 1
}

do_update() {
    local with_build="$1"
    shift
    eval "$(include_recipe "${base_dir}"/recipes/$1)"
    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    # Up to date already? Nothing to do.
    if [[ -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
        return 0
    fi

    # Not previously built? Skip unless caller asked to build missing ones.
    if [[ ${with_build} != yes ]] && ! pkg_previously_built "${name}" "${build_dir}/pkgs" "${JINX_ARCH}"; then
        return 0
    fi

    local -A _hostdeps_collected

    get_hostdeps_file

    local hostdep
    for hostdep in "${!_hostdeps_collected[@]}"; do
        tracked_subshell 'do_host_build_if_needed "${hostdep}"'
    done
    local builddeps_var="$(tracked_subshell 'get_builddeps "${name}"')"
    local dep
    for dep in ${builddeps_var}; do
        tracked_subshell 'do_build_if_needed "${dep}"'
    done
}

do_host_update() {
    local with_build="$1"
    shift
    eval "$(include_recipe "${base_dir}"/host-recipes/$1)"
    if [[ -n ${from_source} ]]; then
        local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
    fi

    # Up to date already? Nothing to do.
    if [[ -f "${build_dir}/host-pkgs/${name}-${version}_${revision}.${host_arch}.xbps" ]]; then
        return 0
    fi

    # Not previously built? Skip unless caller asked to build missing ones.
    if [[ ${with_build} != yes ]] && ! pkg_previously_built "${name}" "${build_dir}/host-pkgs" "${host_arch}"; then
        return 0
    fi

    tracked_subshell 'do_host_pkg "'$1'"'
}

cmd_update() {
    local with_build=no
    if [[ ${1-} == "-b" ]]; then
        local with_build=yes
        shift 1
    fi
    if [[ -z ${1-} ]]; then
        set -- '*'
    fi

    local ppkg
    for ppkg in "$@"; do
        local pkg
        if [[ ${ppkg} == host:* ]]; then
            for pkg in $(cd "${base_dir}/host-recipes" && echo ${ppkg#host:}); do
                tracked_subshell 'do_host_update "${with_build}" "${pkg}"'
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
                tracked_subshell 'do_update "${with_build}" "${pkg}"'
            done
        fi
    done
}

cmd_dry_run() {
    # Print all packages that would be built (space separated), but only those
    # that are not already built in the build cache. Host packages are printed
    # with a 'host:' prefix, in one topological order with the normal ones: a
    # target recipe's hostdeps are host packages and a host recipe's deps are
    # target packages, so the two kinds interleave.
    # Nodes are 'host/<name>' internally because topo_sort splits its graph on ':'.
    if [[ -z ${1-} ]]; then
        set -- '*'
    fi

    local -a roots=()
    local a hpkg pkg
    for a in "$@"; do
        if [[ ${a} == host:* ]]; then
            local _hglob="${a#host:}"
            for hpkg in $(cd "${base_dir}/host-recipes" && echo ${_hglob}); do
                [[ -f "${base_dir}/host-recipes/${hpkg}/recipe" ]] || continue
                roots+=("host/${hpkg}")
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${a}); do
                roots+=("${pkg}")
            done
        fi
    done

    local -A node_deps
    local -A collected

    dry_run_collect() {
        local node="$1"
        [[ -n ${collected[$node]+x} ]] && return
        collected[$node]=1

        local pair edges="" d
        local nsdir rpkg
        if [[ ${node} == host/* ]]; then
            local nsdir=host-recipes
            local rpkg="${node#host/}"
            [[ -f "${base_dir}/host-recipes/${rpkg}/recipe" ]] \
                || die "host recipe '${rpkg}' not found"
        else
            local nsdir=recipes
            local rpkg="${node}"
            [[ -f "${base_dir}/recipes/${rpkg}/recipe" ]] \
                || die "recipe '${rpkg}' not found"
        fi

        local pair=$(eval "$(include_recipe "${base_dir}/${nsdir}/${rpkg}")" \
            && echo "${hostdeps} ${hostrundeps}|${deps} ${builddeps}")
        local srcpair=$(get_source_deps "${rpkg}" "${nsdir}")

        for d in ${pair%%|*} ${srcpair%%|*}; do
            local edges="${edges} host/${d}"
        done
        for d in ${pair#*|} ${srcpair#*|}; do
            local edges="${edges} ${d}"
        done

        node_deps[$node]="${edges}"

        for d in ${edges}; do
            dry_run_collect "${d}"
        done
    }

    local r
    for r in ${roots[@]+"${roots[@]}"}; do
        dry_run_collect "${r}"
    done

    local graph= node
    for node in "${!collected[@]}"; do
        local graph="${graph}${node}:${node_deps[$node]}
"
    done

    local pending=""
    for node in $(topo_sort "${graph}"); do
        if [[ ${node} == host/* ]]; then
            if [[ ! -f "${build_dir}/host-pkgs/$(host_pkg_filename "${node#host/}")" ]]; then
                local pending="${pending} host:${node#host/}"
            fi
        else
            eval "$(include_recipe "${base_dir}"/recipes/"${node}")"
            if [[ -n ${from_source} ]]; then
                local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
            fi
            if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
                local pending="${pending} ${node}"
            fi
        fi
    done

    printf '%s\n' ${pending} | awk '!seen[$0]++{printf "%s ", $0} END{print ""}'
}

cmd_download_for() {
    # Args: repo_url recipes_dir pkgs_dir arch glob1 [glob2 ...]
    local repo_url="$1"
    local recipes_dir="$2"
    local pkgs_dir="$3"
    local arch="$4"
    shift 4

    # Expand package patterns
    local all_packages=""
    local ppkg
    for ppkg in "$@"; do
        local pkg
        for pkg in $(cd "${base_dir}/${recipes_dir}" && echo ${ppkg}); do
            local all_packages="${all_packages} ${pkg}"
        done
    done

    # Collect transitive deps. Nothing is built here, so the only edges that
    # matter are the ones xbps itself records in a binary package: deps and
    # binpkgdeps for a normal recipe, hostrundeps for a host one, exactly what
    # do_pkg and do_host_pkg hand to 'xbps-create -D'. Build-time edges
    # (builddeps, hostdeps, and anything the source step needs) are irrelevant.
    local -A pkg_deps
    local -A bootstrap
    for pkg in $(cd "${base_dir}/${recipes_dir}" && echo *); do
        local info
        if [[ ${recipes_dir} == recipes ]]; then
            info=$(eval "$(include_recipe "${base_dir}/${recipes_dir}/${pkg}")" \
                && echo "${bootstrap_pkg}|${deps} ${binpkgdeps}")
        else
            info=$(eval "$(include_recipe "${base_dir}/${recipes_dir}/${pkg}")" \
                && echo "|${hostrundeps}")
        fi
        bootstrap[$pkg]="${info%%|*}"
        pkg_deps[$pkg]="${info#*|}"
    done

    local -A collected

    collect_all_deps() {
        local pkg="$1"
        [[ -n ${collected[$pkg]+x} ]] && return
        collected[$pkg]=1
        local dep
        for dep in ${pkg_deps[$pkg]}; do
            [[ -n $dep ]] || continue
            # do_pkg keeps a bootstrap package out of what it records, so
            # nothing downloaded will ever ask xbps to resolve one.
            [[ ${bootstrap[$dep]-} == yes ]] && continue
            collect_all_deps "$dep"
        done
    }

    for pkg in ${all_packages}; do
        collect_all_deps "${pkg}"
    done

    # Determine which packages are missing locally
    local download_list=""
    local dep
    for dep in "${!collected[@]}"; do
        eval "$(include_recipe "${base_dir}"/${recipes_dir}/"${dep}")"
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
        fi
        local pkg_filename="${name}-${version}_${revision}.${arch}.xbps"
        if [[ ! -f "${pkgs_dir}/${pkg_filename}" ]]; then
            local download_list="${download_list} ${pkg_filename}"
        fi
    done

    if [[ -z ${download_list} ]]; then
        msg "All requested ${recipes_dir} packages are already in ${pkgs_dir##*/}/"
        return
    fi

    # Fetch repo index for checksum verification
    msg "Fetching the ${arch} repository index"
    make_temp
    local repodata_path="${tmp}"
    wget -O "${repodata_path}" "${repo_url}/${arch}-repodata" \
        || die "failed to fetch repository index from ${repo_url}"

    make_temp
    local index_plist="${tmp}"
    zstdcat "${repodata_path}" | tar -xOf - index.plist >"${index_plist}"

    # Download each missing package
    local pkg_file
    for pkg_file in ${download_list}; do
        msg2 "Downloading ${pkg_file}"
        make_temp
        local dl_path="${tmp}"
        wget -O "${dl_path}" "${repo_url}/${pkg_file}" \
            || die "failed to download ${pkg_file} from ${repo_url}"

        # Verify SHA256 against repodata
        local pkg_name="${pkg_file%.${arch}.xbps}"
        local pkg_name="${pkg_name%-*}"
        local pkg_name="$(printf '%s' "${pkg_name}" | sed 's/[.[\*^$\\]/\\&/g')"
        local expected_sha256="$(sed -n "/<key>${pkg_name}<\\/key>/,/<key>filename-sha256<\\/key>/{
            /<key>filename-sha256<\\/key>/{n;s/.*<string>\\(.*\\)<\\/string>.*/\\1/p;}
        }" "${index_plist}")"

        if [[ -n ${expected_sha256} ]]; then
            local actual_sha256="$(sha256sum "${dl_path}")"
            local actual_sha256="${actual_sha256%% *}"
            if [[ ${actual_sha256} != "${expected_sha256}" ]]; then
                die "SHA256 mismatch for ${pkg_file}:
  expected '${expected_sha256}'
  got      '${actual_sha256}'"
            fi
        fi

        mv "${dl_path}" "${pkgs_dir}/${pkg_file}"

        # Re-index this package
        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${arch}" \
        xbps-rindex \
            -a "${pkgs_dir}/${pkg_file}" \
            -f
    done
}

cmd_download() {
    if [[ -z ${1-} ]]; then
        die "download requires at least one package name"
    fi

    # Split host: targets from normal ones; each group is downloaded against
    # its own arch repodata, from its own repo URL, into its own pkgs/ tree.
    local -a host_globs=() normal_args=()
    local a
    for a in "$@"; do
        if [[ ${a} == host:* ]]; then
            host_globs+=("${a#host:}")
        else
            normal_args+=("${a}")
        fi
    done

    if (( ${#normal_args[@]} > 0 )); then
        if [[ -z ${JINX_REPO_URL-} ]]; then
            die "JINX_REPO_URL not set in Jinxfile"
        fi
        cmd_download_for "${JINX_REPO_URL}" recipes "${build_dir}/pkgs" "${JINX_ARCH}" "${normal_args[@]}"
    fi
    if (( ${#host_globs[@]} > 0 )); then
        if [[ -z ${JINX_HOST_REPO_URL-} ]]; then
            die "JINX_HOST_REPO_URL not set in Jinxfile (required for downloading host packages)"
        fi
        cmd_download_for "${JINX_HOST_REPO_URL}" host-recipes "${build_dir}/host-pkgs" "${host_arch}" "${host_globs[@]}"
    fi

    msg "Download complete"
}

cmd_regen() {
    local ppkg
    for ppkg in "$@"; do
        local pkg
        if [[ ${ppkg} == host:* ]]; then
            for pkg in $(cd "${base_dir}/host-recipes" && echo ${ppkg#host:}); do
                tracked_subshell 'do_regen "${pkg}" host-recipes'
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
                tracked_subshell 'do_regen "${pkg}" recipes'
            done
        fi
    done
}

do_run_in() {
    local pkg="$1"
    local cmd_file="$2"

    eval "$(include_recipe "${base_dir}"/recipes/${pkg})"

    mkdir -p "${build_dir}"/builds/${name}

    if [[ -n ${from_source} || -n ${tarball_url} || -n ${git_url} || -n ${source_dir} ]]; then
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
            local source_dir="$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$source_dir")"
        else
            local from_source=${name}
        fi

        if [[ -z ${source_dir} ]]; then
            local source_dir="${base_dir}"/${_sources_root}/${from_source}
        else
            local source_dir="${base_dir}"/"${source_dir}"
        fi
    fi

    local prefix="/usr"
    local sysroot="/sysroot"

    cd "${build_dir}"/builds/${name}

    set --
    . "${cmd_file}"
}

do_run_in_host() {
    local pkg="$1"
    local cmd_file="$2"

    eval "$(include_recipe "${base_dir}"/host-recipes/${pkg})"

    mkdir -p "${build_dir}"/host-builds/${name}

    if [[ -n ${from_source} || -n ${tarball_url} || -n ${git_url} || -n ${source_dir} ]]; then
        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
            local source_dir="$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$source_dir")"
        else
            local from_source=${name}
        fi

        if [[ -z ${source_dir} ]]; then
            local source_dir="${base_dir}"/${_sources_root}/${from_source}
        else
            local source_dir="${base_dir}"/"${source_dir}"
        fi
    fi

    local prefix="/usr/local"
    local sysroot="/sysroot"

    cd "${build_dir}"/host-builds/${name}

    set --
    . "${cmd_file}"
}

cmd_run_in() {
    if [[ -z ${1-} ]]; then
        die "run-in requires a recipe name"
    fi
    local recipe_glob="$1"
    shift 1
    if [[ -z ${1-} ]]; then
        die "run-in requires a command to run"
    fi

    local recipes_dir=recipes
    local internal_cmd=internal-run-in
    local builds_dir=builds
    if [[ ${recipe_glob} == host:* ]]; then
        local recipes_dir=host-recipes
        local internal_cmd=internal-run-in-host
        local builds_dir=host-builds
        local recipe_glob="${recipe_glob#host:}"
    fi

    local run_in_recipe
    for run_in_recipe in $(cd "${base_dir}/${recipes_dir}" && echo ${recipe_glob}); do
        if [[ ! -f "${base_dir}/${recipes_dir}/${run_in_recipe}/recipe" ]]; then
            die "recipe '${recipes_dir}/${run_in_recipe}' not found"
        fi

        eval "$(include_recipe "${base_dir}"/${recipes_dir}/${run_in_recipe})"

        if [[ -n ${from_source} ]]; then
            tracked_subshell 'do_source "${from_source}" "${_from_source_dir}"'
        else
            tracked_subshell 'do_source "${name}" "${recipes_dir}"'
        fi

        make_temp
        local cmd_file="${tmp}"
        {
            printf 'exec'
            local arg
            for arg in "$@"; do
                local escaped="$arg"
                local escaped="${escaped//\\/\\\\}"
                local escaped="${escaped//\"/\\\"}"
                local escaped="${escaped//\`/\\\`}"
                printf ' "%s"' "$escaped"
            done
            printf '\n'
        } >"${cmd_file}"
        local cmd_file_inner="/jinx-tmp/$(basename "${cmd_file}")"

        local container_pkgs=
        local sysroot=
        local imgroot=
        if [[ ${recipes_dir} == host-recipes ]]; then
            # Host recipes always use the cross-compile flow, regardless of
            # JINX_NATIVE_MODE (host_arch sysroot at /sysroot, host pkgs at /usr/local).
            local cross_compile=yes
        fi
        prepare_container

        mkdir -p "${build_dir}"/${builds_dir}/${name}

        local container_sources_ro=
        local container_base_dir_ro=
        local allow_network=yes
        run_in_container "${internal_cmd}" "${run_in_recipe}" "${cmd_file_inner}"

        destroy_container
    done
}

cmd_rebuild() {
    local ppkg
    for ppkg in "$@"; do
        local pkg
        if [[ ${ppkg} == host:* ]]; then
            for pkg in $(cd "${base_dir}/host-recipes" && echo ${ppkg#host:}); do
                tracked_subshell 'do_host_rebuild "${pkg}"'
            done
        else
            for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
                tracked_subshell 'do_rebuild "${pkg}"'
            done
        fi
    done
}

revbump_one_recipe() {
    # Rewrite the first literal 'revision=' line, incrementing the integer and
    # preserving indentation, quoting style and trailing whitespace.
    local recipe_file="$1"
    local label="$2"

    if [[ ! -f ${recipe_file} ]]; then
        die "revbump: recipe file '${recipe_file}' not found"
    fi

    local rev_re='^([[:space:]]*)revision=("?|'\''?)([0-9]+)("?|'\''?)([[:space:]]*)$'

    make_temp
    local out="${tmp}"

    local count=0
    local old_rev=
    local line
    while IFS= read -r line || [[ -n ${line} ]]; do
        if [[ ${line} =~ $rev_re ]]; then
            local count=$((count + 1))
            if [[ ${count} == 1 ]]; then
                local old_rev="${BASH_REMATCH[3]}"
                local line="${BASH_REMATCH[1]}revision=${BASH_REMATCH[2]}$((old_rev + 1))${BASH_REMATCH[4]}${BASH_REMATCH[5]}"
            fi
        fi
        printf '%s\n' "${line}"
    done <"${recipe_file}" >"${out}"

    if [[ ${count} != 1 ]]; then
        die "revbump: recipe '${label}' has ${count} literal 'revision=' line(s); expected exactly 1 (bump it manually)"
    fi

    mv "${out}" "${recipe_file}"

    msg2 "${label}: revision ${old_rev} -> $((old_rev + 1))"
}

cmd_revbump() {
    # Bump the revision of every recipe that depends, directly or
    # transitively, on the given package(s). Targets and dependents may be
    # normal recipes or host recipes (selected with the 'host:' prefix).
    # 'deps'/'builddeps' and 'source_deps' resolve in recipes/,
    # 'hostdeps'/'hostrundeps' and 'source_hostdeps' in host-recipes/, so the
    # graph spans both namespaces.
    if [[ -z ${1-} ]]; then
        die "revbump requires at least one package name"
    fi

    local -A revdeps
    local nsdir pkg
    for nsdir in recipes host-recipes; do
        for pkg in $(cd "${base_dir}/${nsdir}" && echo *); do
            [[ -f "${base_dir}/${nsdir}/${pkg}/recipe" ]] || continue
            local node="${nsdir}/${pkg}"

            local depinfo
            depinfo="$(eval "$(include_recipe "${base_dir}/${nsdir}/${pkg}")" \
                && printf '%s\n%s\n' "${deps} ${builddeps}" "${hostdeps} ${hostrundeps}")"
            local rdeps_line="${depinfo%%$'\n'*}"
            local rhost_line="${depinfo#*$'\n'}"
            local rhost_line="${rhost_line%%$'\n'*}"

            # Preparing the source is part of building the package, so what the
            # source step needs is a revbump edge just like what the build does.
            local srcpair="$(get_source_deps "${pkg}" "${nsdir}")"
            local rhost_line="${rhost_line} ${srcpair%%|*}"
            local rdeps_line="${rdeps_line} ${srcpair#*|}"

            local d
            for d in ${rdeps_line}; do
                [[ -n $d ]] && revdeps["recipes/${d}"]+=" ${node}"
            done
            for d in ${rhost_line}; do
                [[ -n $d ]] && revdeps["host-recipes/${d}"]+=" ${node}"
            done
        done
    done

    local -A to_bump
    local -A targets

    revbump_visit() {
        local n="$1"
        local r
        for r in ${revdeps[$n]-}; do
            if [[ -z ${to_bump[$r]+x} ]]; then
                to_bump[$r]=1
                revbump_visit "$r"
            fi
        done
    }

    local ppkg
    for ppkg in "$@"; do
        local tns tglob
        if [[ ${ppkg} == host:* ]]; then
            local tns=host-recipes
            local tglob="${ppkg#host:}"
        else
            local tns=recipes
            local tglob="${ppkg}"
        fi
        for pkg in $(cd "${base_dir}/${tns}" && echo ${tglob}); do
            if [[ ! -f "${base_dir}/${tns}/${pkg}/recipe" ]]; then
                die "revbump: recipe '${tns}/${pkg}' not found"
            fi
            targets["${tns}/${pkg}"]=1
            revbump_visit "${tns}/${pkg}"
        done
    done

    # A requested package is the changed input itself, never a bump target.
    local node
    local bumped_any=no
    for node in $(printf '%s\n' "${!to_bump[@]}" | sort); do
        [[ -n ${targets[$node]+x} ]] && continue
        revbump_one_recipe "${base_dir}/${node}/recipe" "${node}"
        local bumped_any=yes
    done

    if [[ ${bumped_any} == no ]]; then
        msg "No dependents found for: $*"
    fi
}

pkg_file_list() {
    # The paths the built package $1 contains, minus its metadata entries.
    # pipefail matters here: the trailing 'grep || true' always succeeds, so
    # without it a failed decompression would read as an empty package and
    # quietly turn the caller's conflict check into a no-op.
    local -
    set -o pipefail

    zstdcat "$1" | tar -tf - | ( grep -v "${files_to_ignore}" || true )
}

cmd_install() {
    local force_install=""
    if [[ ${1-} == "-f" ]]; then
        local force_install="$1"
        shift 1
    fi
    if [[ -z ${1-} ]]; then
        die "install requires a sysroot directory"
    fi
    local sysroot="$1"
    shift 1
    mkdir -m 755 -p "${sysroot}"

    local pkgs_to_install=""
    local ppkg
    for ppkg in "$@"; do
        local pkg
        for pkg in $(cd "${base_dir}/recipes" && echo ${ppkg}); do
            local bootstrap_pkg=$(eval "$(include_recipe "${base_dir}"/recipes/${pkg})" && echo "${bootstrap_pkg}")
            if [[ ${bootstrap_pkg} == yes ]]; then
                continue
            fi

            local pkgs_to_install="${pkgs_to_install} ${pkg}"
        done
    done

    local files_to_ignore='\.keep
\.plist
/INSTALL
/REMOVE'

    make_temp
    local all_files="${tmp}"

    for pkg in ${pkgs_to_install}; do
        msg "Installing ${pkg}"

        tracked_subshell '
        eval "$(include_recipe "${base_dir}"/recipes/${pkg})"

        if [[ -n ${from_source} ]]; then
            local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
        fi

        if [[ ! -f "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" ]]; then
            if [[ $(id -u) == 0 ]]; then
                die "a package needs to be built, but Jinx was invoked as root"
            fi
            tracked_subshell '\''do_pkg "${pkg}"'\''
        fi

        # xbps seems to only install the package every second time when reinstalling.
        # Remove the package to be sure it gets reinstalled.
        if [[ -n ${force_install} ]]; then
            XBPS_ARCH=invalid \
            XBPS_TARGET_ARCH="${JINX_ARCH}" \
                xbps-remove -Ffy -r "${sysroot}" ${pkg} >/dev/null 2>&1 || true
        fi

        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
            xbps-install -y $force_install -r "${sysroot}" -R "${build_dir}"/pkgs ${pkg} >/dev/null 2>&1

        pkg_file_list "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" >>"${all_files}"
        '
    done

    msg "Checking for file conflicts"

    make_temp
    local all_files_sorted="${tmp}"

    make_temp
    local all_files_uniq="${tmp}"

    sort <"${all_files}" >"${all_files_sorted}"
    uniq <"${all_files_sorted}" >"${all_files_uniq}"

    local dup_elements="$(comm -23 "${all_files_sorted}" "${all_files_uniq}" | uniq)"

    if [[ -n ${dup_elements} ]]; then
        error "duplicate files were found:"
        local elem owners
        for elem in ${dup_elements}; do
            owners=
            for pkg in ${pkgs_to_install}; do
                owners+=$(tracked_subshell '
                eval "$(include_recipe "${base_dir}"/recipes/${pkg})"

                if [[ -n ${from_source} ]]; then
                    local version=$(eval "$(source_source_recipe "${from_source}" "${_from_source_dir}")" && echo "$version")
                fi

                if pkg_file_list "${build_dir}/pkgs/${name}-${version}_${revision}.${JINX_ARCH}.xbps" | grep -q "${elem}"; then
                    printf " %s" "${pkg}"
                fi
                ')
            done
            msg2 "${elem}:${owners}"
        done
        exit 1
    fi
}

reinit_container() {
    force_remove "$JINX_CACHE_DIR/sets" "$JINX_CACHE_DIR/apt-cache"

    mkdir -p "${apt_cache}"
    mkdir -p "${JINX_CACHE_DIR}/tmp"

    mkdir -p "$JINX_CACHE_DIR/sets/.image"

    # Fetch the pre-built nochown.so for this host arch, verify, drop it into
    # the container's rootfs so the LD_PRELOAD references at /nochown.so work.
    local nochown_sha256="${NOCHOWN_SHA256[${host_arch}]-}"
    if [[ -z ${nochown_sha256} || ${nochown_sha256} == "?" ]]; then
        die "no pre-built nochown.so published for host arch '${host_arch}' (see NOCHOWN_SHA256 in jinx)"
    fi
    wget -O "$JINX_CACHE_DIR/sets/.image/nochown.so" "${NOCHOWN_RELEASE_URL_BASE}/nochown-linux-${host_arch}.so"
    if ! sha256sum "$JINX_CACHE_DIR/sets/.image/nochown.so" | grep "${nochown_sha256}" >/dev/null 2>&1; then
        die "failed to verify nochown.so"
    fi

    local DEBOOTSTRAP_ARCH="$(uname -m)"
    case "${DEBOOTSTRAP_ARCH}" in
        i?86) local DEBOOTSTRAP_ARCH=i386 ;;
        x86_64) local DEBOOTSTRAP_ARCH=amd64 ;;
        arm*) local DEBOOTSTRAP_ARCH=armhf ;;
        aarch64) local DEBOOTSTRAP_ARCH=arm64 ;;
        loongarch64) local DEBOOTSTRAP_ARCH=loong64 ;;
        ppc64le) local DEBOOTSTRAP_ARCH=ppc64el ;;
    esac

    # debootstrap only knows two extractors, 'ar' and dpkg-deb. Ship a stand-in
    # for the two ar flags it uses instead of requiring binutils, ahead of the
    # host's PATH like Jinx's own xbps and debootstrap, and pin --extractor=ar
    # below so no host bootstraps through a different one.
    mkdir -p "${JINX_CACHE_DIR}/bin"
    cat <<'EOF' >"${JINX_CACHE_DIR}/bin/ar"
#! /bin/sh
# Minimal stand-in for 'ar', supporting only the two forms debootstrap uses:
#   ar -t <archive>           - list member names
#   ar -p <archive> <member>  - write one member to stdout
# An ar header is plain ASCII, so head/tail can do the whole job. Long member
# names (GNU's '//' table, BSD's '#1/') are not handled: .deb archives never
# carry names that need them.

set -eu

mode="$1"
archive="$2"

offset=8
while :; do
    name="$(tail -c "+$((offset + 1))" "${archive}" | head -c 16)"
    [ -n "${name}" ] || break

    size="$(tail -c "+$((offset + 49))" "${archive}" | head -c 10)"

    # Undo ar's padding: trailing spaces on both fields, plus the trailing '/'
    # GNU ar appends to a member name.
    name="${name%"${name##*[! ]}"}"
    name="${name%/}"
    size="${size%"${size##*[! ]}"}"

    case "${mode}" in
        -t)
            echo "${name}"
            ;;
        -p)
            if [ "${name}" = "${3-}" ]; then
                tail -c "+$((offset + 61))" "${archive}" | head -c "${size}"
                exit 0
            fi
            ;;
    esac

    offset=$((offset + 60 + size + size % 2))
done
EOF
    chmod 0755 "${JINX_CACHE_DIR}/bin/ar"

    # Install debootstrap. Upstream ships the install step as a Makefile
    # target, but it is only a few copies plus a @VERSION@ substitution, so do
    # it inline and keep make out of the prerequisites. The version is taken
    # from debian/changelog exactly the way that Makefile takes it.
    tracked_subshell '
        cd "${JINX_CACHE_DIR}"
        make_temp -d
        local _ds_tmp="${tmp}"
        wget -O "${_ds_tmp}/debootstrap.tar.gz" "${debootstrap_url}"
        if ! sha256sum "${_ds_tmp}/debootstrap.tar.gz" | grep "${debootstrap_sha256sum}" >/dev/null 2>&1; then
            die "failed to verify the debootstrap tarball"
        fi
        # Its top directory is called debootstrap/ too.
        tar -zxf "${_ds_tmp}/debootstrap.tar.gz" -C "${_ds_tmp}"

        local _ds_src="${_ds_tmp}/debootstrap"
        local _ds_share="debootstrap/usr/share/debootstrap"
        local _ds_ver="$(sed "s/.*(\(.*\)).*/\1/; q" "${_ds_src}/debian/changelog")"

        mkdir -p "${_ds_share}/scripts" debootstrap/usr/sbin
        cp -a "${_ds_src}"/scripts/* "${_ds_share}/scripts/"
        cp "${_ds_src}/functions" "${_ds_share}/functions"
        chmod 0644 "${_ds_share}/functions"

        sed "s/@VERSION@/${_ds_ver}/g;s/HOST_ARCH=[^;#]*/HOST_ARCH=${DEBOOTSTRAP_ARCH}/g;s|DEBOOTSTRAP_DIR=/usr/share/debootstrap|DEBOOTSTRAP_DIR=\"$(pwd -P)/debootstrap/usr/share/debootstrap\"|g" "${_ds_src}/debootstrap" >debootstrap/usr/sbin/debootstrap
        chmod 0755 debootstrap/usr/sbin/debootstrap
    '

    mkdir -p "$JINX_CACHE_DIR/sets/.image/var/cache/apt/archives"

    unshare --user --map-root-user --mount --pid --fork -- "$BASH" -c "
        set -e

        mount --bind '${apt_cache}' '$JINX_CACHE_DIR/sets/.image/var/cache/apt/archives'

        LD_PRELOAD='$JINX_CACHE_DIR/sets/.image/nochown.so' debootstrap \
            --foreign --variant=minbase --extractor=ar sid '$JINX_CACHE_DIR/sets/.image' https://snapshot.debian.org/archive/debian/${JINX_DEBIAN_SNAPSHOT}/
    "

    local dir
    for dir in dev proc sys run tmp var/tmp; do
        force_remove "${JINX_CACHE_DIR}/sets/.image/${dir}"
        mkdir -p "${JINX_CACHE_DIR}/sets/.image/${dir}"
    done

    rm "${JINX_CACHE_DIR}/sets/.image/etc/resolv.conf"
    echo localhost >"${JINX_CACHE_DIR}/sets/.image/etc/hostname"

    run_in_container1 "$JINX_CACHE_DIR/sets/.image" /debootstrap/debootstrap --second-stage

    echo 'en_US.UTF-8 UTF-8' > "$JINX_CACHE_DIR/sets/.image/etc/locale.gen"
    echo 'APT::Install-Suggests "0";
APT::Install-Recommends "0";
APT::Sandbox::User "root";
Acquire::Check-Valid-Until "0";' >> "$JINX_CACHE_DIR/sets/.image/etc/apt/apt.conf"

    run_in_container1 "$JINX_CACHE_DIR/sets/.image" apt-get update
    run_in_container1 "$JINX_CACHE_DIR/sets/.image" apt-get install -y locales
    run_in_container1 "$JINX_CACHE_DIR/sets/.image" locale-gen

    # Fix permissions of files
    find "$JINX_CACHE_DIR/sets/.image" -perm 000 -exec chmod 755 {} + 2>/dev/null

    run_in_container1 "$JINX_CACHE_DIR/sets/.image" apt-get install -y bash bzip2 ca-certificates curl diffutils findutils gawk git grep gzip lzip netbase patch procps sed tar unzip xz-utils zstd ${JINX_BASE_PACKAGES-}

    if [[ -n ${JINX_CMAKE_PLATFORM-} ]]; then
        cp "${base_dir}/${JINX_CMAKE_PLATFORM}" "${JINX_CACHE_DIR}"/sets/.image/usr/share/cmake-*/Modules/Platform/
    fi

    # Fetch the pre-built static-musl xbps tarball for this host arch from the
    # xbps-static-builds CI repo, verify, extract. Building xbps locally is
    # avoided because Debian doesn't ship musl-linked libssl/libarchive/etc.,
    # and statically linked glibc breaks libfetch's networking via NSS.
    local xbps_sha256="${XBPS_SHA256[${host_arch}]-}"
    if [[ -z ${xbps_sha256} || ${xbps_sha256} == "?" ]]; then
        die "no pre-built xbps tarball published for host arch '${host_arch}' (see XBPS_SHA256 in jinx)"
    fi

    local xbps_dirname="xbps-static-bin-linux-${host_arch}"
    local xbps_tarball="${xbps_dirname}.tar.gz"
    wget -O "${JINX_CACHE_DIR}/${xbps_tarball}" "${XBPS_RELEASE_URL_BASE}/${xbps_tarball}"
    if ! sha256sum "${JINX_CACHE_DIR}/${xbps_tarball}" | grep "${xbps_sha256}" >/dev/null 2>&1; then
        die "failed to verify the xbps tarball"
    fi

    # The tarball wraps everything in a top-level ${xbps_dirname}/ dir; extract
    # then rename so ${JINX_CACHE_DIR}/xbps/bin is where PATH expects it.
    ( cd "${JINX_CACHE_DIR}" && gunzip < "${xbps_tarball}" | tar -xf - )
    force_remove "${JINX_CACHE_DIR}/xbps"
    mv "${JINX_CACHE_DIR}/${xbps_dirname}" "${JINX_CACHE_DIR}/xbps"
    rm "${JINX_CACHE_DIR}/${xbps_tarball}"
}

first_use() {
    msg "Preparing the Jinx cache"

    reinit_container

    echo "${jinx_version}" >"${JINX_CACHE_DIR}/version"
    echo "${JINX_DEBIAN_SNAPSHOT}" >"${JINX_CACHE_DIR}/debian_snapshot"
    echo "${JINX_BASE_PACKAGES-}" >"${JINX_CACHE_DIR}/base_packages"

    msg "The Jinx cache is ready"
}

redo_first_use() {
    # Without a version stamp, whatever is there is what an interrupted first
    # run left behind, not an old cache.
    if [[ -f "${JINX_CACHE_DIR}/version" ]]; then
        msg "Purging the old Jinx cache"
    fi

    # Everything except the lock file: it is held open right now, and removing
    # it drops the mutual exclusion for the rest of this run and leaves the
    # next run - possibly a 'jinx install' as root - to recreate it.
    local -a _stale=()
    local _entry
    for _entry in "${JINX_CACHE_DIR}"/* "${JINX_CACHE_DIR}"/.[!.]*; do
        [[ -e ${_entry} || -L ${_entry} ]] || continue
        [[ ${_entry} == "${JINX_CACHE_DIR}/jinx.lock" ]] && continue
        _stale+=("${_entry}")
    done
    if (( ${#_stale[@]} > 0 )); then
        force_remove "${_stale[@]}"
    fi

    first_use
}

# A cache that root rebuilt would lock its owner out of it, so as root, have the
# user owning the cache directory rebuild it.
rebuild_cache_as_owner() {
    local owner
    owner="$(stat -c '%u:%g' "${JINX_CACHE_DIR}")"
    if [[ ${owner%%:*} == 0 ]]; then
        die "the Jinx cache needs to be rebuilt, which must not happen as root; run any jinx command as the user who builds the packages first"
    fi

    # The rebuild takes the lock itself, for as long as it runs. Perl drops the
    # privileges, as busybox's setpriv cannot change users and debootstrap
    # needs perl anyway.
    exec 9<&-
    perl -e '
        my ($uid, $gid) = (shift, shift);
        $) = "$gid $gid";
        $( = $gid;
        ($<, $>) = ($uid, $uid);
        die "jinx: could not drop root privileges\n" if $< != $uid || $> != $uid;
        exec { $ARGV[0] } @ARGV or die "jinx: cannot run $ARGV[0]: $!\n";
    ' "${owner%%:*}" "${owner#*:}" "${script}" rebuild-cache
    exec 9<"${JINX_CACHE_DIR}/jinx.lock"
    if ! flock -n 9; then
        die "another jinx started while the cache was being rebuilt"
    fi
}

if [[ ! -f $JINX_CONFIG_FILE ]]; then
    die "missing Jinxfile in directory '$base_dir'"
fi

unset JINX_MAJOR_VER
unset JINX_DEBIAN_SNAPSHOT
unset JINX_BASE_PACKAGES
unset JINX_CMAKE_PLATFORM
unset JINX_REPO_URL
unset JINX_HOST_REPO_URL
. "${JINX_CONFIG_FILE}"

if [[ -z ${JINX_MAJOR_VER-} ]]; then
    die "required Jinxfile variable JINX_MAJOR_VER missing"
fi

if [[ ${JINX_MAJOR_VER} != "${jinx_major_ver}" ]]; then
    die "needed major version (${JINX_MAJOR_VER}) differs from Jinx-provided major version (${jinx_major_ver})"
fi

if [[ -z ${JINX_DEBIAN_SNAPSHOT-} ]]; then
    die "required Jinxfile variable JINX_DEBIAN_SNAPSHOT missing"
fi

if [[ -z ${JINX_ARCH-} ]]; then
    die "required config variable \$JINX_ARCH missing"
fi

# Inside the build container, the cache is the one this very build runs from,
# and a Jinxfile that evaluates differently there must not rebuild it.
if [[ ${in_container} == false ]]; then
    if  [[ ! -f "${JINX_CACHE_DIR}/version" || $(cat "${JINX_CACHE_DIR}/version") != "${jinx_version}" ]] \
     || [[ ! -f "${JINX_CACHE_DIR}/debian_snapshot" || $(cat "${JINX_CACHE_DIR}/debian_snapshot") != "${JINX_DEBIAN_SNAPSHOT}" ]] \
     || [[ ! -f "${JINX_CACHE_DIR}/base_packages" || $(cat "${JINX_CACHE_DIR}/base_packages") != "${JINX_BASE_PACKAGES-}" ]]; then
        if [[ $(id -u) == 0 ]]; then
            rebuild_cache_as_owner
        else
            redo_first_use
        fi
    fi
fi

case "$1" in
    internal-prepare)
        do_prepare "$2" "$3"
        ;;
    internal-fetch)
        do_fetch "$2" "$3"
        ;;
    internal-patch)
        do_patch "$2" "$3"
        ;;
    internal-configure-host)
        do_configure_host "$2"
        ;;
    internal-build-host)
        do_build_host "$2"
        ;;
    internal-package-host)
        do_package_host "$2"
        ;;
    internal-configure)
        do_configure "$2"
        ;;
    internal-build)
        do_build "$2"
        ;;
    internal-package)
        do_package "$2"
        ;;
    internal-run-in)
        shift 1
        do_run_in "$@"
        ;;
    internal-run-in-host)
        shift 1
        do_run_in_host "$@"
        ;;
    build)
        shift 1
        cmd_build "$@"
        ;;
    update)
        shift 1
        cmd_update "$@"
        ;;
    regenerate|regen)
        shift 1
        cmd_regen "$@"
        ;;
    rebuild)
        shift 1
        cmd_rebuild "$@"
        ;;
    revbump)
        shift 1
        cmd_revbump "$@"
        ;;
    install)
        shift 1
        cmd_install "$@"
        ;;
    rebuild-cache)
        redo_first_use
        ;;
    dry-run)
        shift 1
        cmd_dry_run "$@"
        ;;
    download)
        shift 1
        cmd_download "$@"
        ;;
    run-in)
        shift 1
        cmd_run_in "$@"
        ;;
    *)
        die "unknown command '$1'; see '$0 help'"
        ;;
esac
