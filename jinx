set -eu

# Optional environment variables - initialise to empty so set -u is satisfied
# regardless of whether the user/parent shell set them.
: "${JINX_PARALLELISM:=}"
: "${JINX_CACHE_DIR:=}"
: "${JINX_NATIVE_MODE:=}"
: "${JINX_NATIVE_LANG:=}"
: "${JINX_CLEAN_WORKDIRS:=}"
: "${TERM:=}"
: "${COLORTERM:=}"

IFS=$' \t\n'

export LC_COLLATE=C

umask 0022

jinx_major_ver="0.11"
jinx_minor_ver="0"

jinx_version="${jinx_major_ver}.${jinx_minor_ver}"

