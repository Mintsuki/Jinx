# Debian's own source package of debootstrap, which snapshot.debian.org serves
# byte for byte forever, unlike the archives that salsa generates on demand.
debootstrap_version=1.0.145
debootstrap_url="https://snapshot.debian.org/archive/debian/20260831T204404Z/pool/main/d/debootstrap/debootstrap_${debootstrap_version}.tar.gz"
debootstrap_sha256sum=7cc8f9e386ed8dfd4b062a3b9527f0f45176dfa1b065e7db270f837956516b20

# NO_COLOR and TERM=dumb are the usual ways to ask for plain output.
if [[ -t 2 && -z ${NO_COLOR-} && ${TERM} != dumb ]]; then
    c_bold=$'\033[1m'
    c_red=$'\033[1;31m'
    c_green=$'\033[1;32m'
    c_yellow=$'\033[1;33m'
    c_blue=$'\033[1;34m'
    c_off=$'\033[0m'
else
    c_bold=
    c_red=
    c_green=
    c_yellow=
    c_blue=
    c_off=
fi

# Messages go to standard error, which keeps standard output for what scripts
# read, such as the package list of 'closure'.
msg() {
    printf '%s==>%s %s%s%s\n' "${c_green}" "${c_off}" "${c_bold}" "$*" "${c_off}" >&2
}

msg2() {
    printf '  %s->%s %s%s%s\n' "${c_blue}" "${c_off}" "${c_bold}" "$*" "${c_off}" >&2
}

warning() {
    printf '%s==> WARNING:%s %s%s%s\n' "${c_yellow}" "${c_off}" "${c_bold}" "$*" "${c_off}" >&2
}

error() {
    printf '%s==> ERROR:%s %s%s%s\n' "${c_red}" "${c_off}" "${c_bold}" "$*" "${c_off}" >&2
}

die() {
    error "$*"
    exit 1
}

if [[ -z ${1-} ]]; then
    die "no command specified; see '$0 help'"
fi

cmd_help() {
    echo "usage: $0 <command> [args...]"
    printf "\n   help|--help        Displays this message"
    printf "\n   version|--version  Prints the version"
    printf "\n   init               Initialises a build directory"
    printf "\n   update             Rebuild outdated package(s); use '-b' to also build never-built ones"
    printf "\n   build              Builds package(s), does incremental builds"
    printf "\n   rebuild            Rebuilds package(s)"
    printf "\n   revbump            Bumps the revision of all (transitive) dependents of package(s)"
    printf "\n   regenerate|regen   Regenerates patch for package(s) and re-runs prepare step"
    printf "\n   install            Installs package(s) (use '-f' to reinstall)"
    printf "\n   dry-run            Prints all packages that need to be built in order (space separated)"
    printf "\n   download           Downloads pre-built package(s) from remote repo"
    printf "\n   run-in             Runs a command in a container prepared with a recipe's hostdeps"
    printf "\n   rebuild-cache      Rebuilds Jinx cache"
    printf "\n\nexample: $0 update '*'\n"
}

# Single quotes, unlike printf %q, read back the same in any POSIX shell, and
# .jinx-parameters is meant to be sourced by scripts as well.
shell_quote() {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

cmd_init() {
    if [[ -z ${1-} ]]; then
        die "init requires a directory argument"
    fi

    local dir="$1"
    shift 1

    local p
    for p in "$@"; do
        if [[ ${p} != *=* || ! ${p%%=*} =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            die "init: '${p}' is not of the form KEY=VALUE"
        fi
        case "${p%%=*}" in
            INIT_MAJOR_VER|SOURCE_DIR)
                die "init: ${p%%=*} is set by init itself"
                ;;
        esac
    done

    local srcdir
    local builddir

    if [[ -f "${dir}/Jinxfile" ]]; then
        # <dir> is the source directory; the current directory is the build directory.
        local srcdir="${dir}"
        local builddir="$(pwd -P)"
    elif [[ -f Jinxfile ]]; then
        # The current directory is the source; <dir> is a build directory to create.
        if [[ -e "${dir}" ]]; then
            die "'${dir}' already exists; when the current directory is the source, <dir> must be a new directory to create as the build directory"
        fi
        local srcdir="$(pwd -P)"
        mkdir -p "${dir}"
        local builddir="$(cd "${dir}" && pwd -P)"
    else
        die "could not find a Jinxfile in '${dir}' or in the current directory"
    fi

    if [[ -f "${builddir}/.jinx-parameters" ]]; then
        die "'${builddir}' is already initialised; remove its .jinx-parameters first"
    fi

    if [[ -f "${builddir}/Jinxfile" ]]; then
        die "In-tree builds are not supported"
    fi

    {
        printf '#! /bin/sh\n\n'
        printf 'JINX_INIT_MAJOR_VER=%s\n' "$(shell_quote "${jinx_major_ver}")"
        printf 'JINX_SOURCE_DIR=%s\n' "$(shell_quote "${srcdir}")"
        printf 'JINX_ARCH=%s\n' "$(shell_quote "$(uname -m)")"
        for p in "$@"; do
            printf 'JINX_%s=%s\n' "${p%%=*}" "$(shell_quote "${p#*=}")"
        done
    } >"${builddir}/.jinx-parameters"

    msg "Initialised '${builddir}' as build directory with '${srcdir}' as source directory"
}

case "$1" in
    version|--version)
        echo "Jinx version $jinx_version"
        exit 0
        ;;
    help|--help)
        cmd_help
        exit 0
        ;;
    init)
        shift 1
        cmd_init "$@"
        exit 0
        ;;
esac

if [[ $(uname -s) != Linux ]]; then
    die "Jinx only supports running on Linux hosts."
fi

script_name="$(basename "$0")"
script_dir="$(dirname "$0")"
if [[ $script_dir == . || -z $script_dir ]]; then
    if [[ $0 == */* ]]; then
        script_dir=.
    else
        script_dir="$(dirname "$(command -v "${script_name}")")"
    fi
fi
script_dir="$(cd "${script_dir}" && pwd -P)"
script="${script_dir}/${script_name}"

in_container=false
if [[ $script == //jinx ]]; then
    in_container=true
fi

# Checked before anything below can take the lock or rebuild the cache.
case "$1" in
    build|update|regenerate|regen|rebuild|revbump|install|rebuild-cache|dry-run|download|run-in)
        ;;
    internal-*)
        if [[ ${in_container} == false ]]; then
            die "'$1' is only for Jinx's own use inside the build container"
        fi
        ;;
    *)
        die "unknown command '$1'; see '$0 help'"
        ;;
esac

case "$1" in
    install)
        ;;
    *)
        if [[ ${in_container} == false && $(id -u) == 0 ]]; then
            die "Jinx does not support running as root."
        fi
        ;;
esac

compute_parallelism() {
    if [[ -n ${JINX_PARALLELISM} ]]; then
        echo "${JINX_PARALLELISM}"
        return
    fi

    local max_threads_by_mem=$(( ((($(LC_ALL=C free | awk '/^Mem:/{print $7}') + 1048575) / 1048576) + 1) / 2 ))
    local threads="$(nproc 2>/dev/null || echo 1)"
    local threads=$(( threads < max_threads_by_mem ? threads : max_threads_by_mem ))

    echo $(( threads > 0 ? threads : 1 ))
}

parallelism="$(compute_parallelism)"

# Architecture tag for host packages. Host recipes build native tools that run
# on the build machine, so they are keyed on the build host's arch, independent
# of JINX_ARCH (which is the target arch and may differ for cross builds).
host_arch="$(uname -m)"

if [[ ${in_container} == false ]]; then
    build_dir="$(pwd -P)"
else
    build_dir=/build_dir
fi

if [[ ! -f "${build_dir}/.jinx-parameters" ]]; then
    die "Please run '$0 init <source dir> <parameters>' first"
fi

. "${build_dir}"/.jinx-parameters

if [[ ${JINX_INIT_MAJOR_VER-} != "${jinx_major_ver}" ]]; then
    die "build directory '${build_dir}' was initialised with Jinx major version '${JINX_INIT_MAJOR_VER-(none)}', incompatible with this Jinx ${jinx_major_ver}. Delete the build directory and run 'jinx init' again to start over."
fi

if [[ ${in_container} == false ]]; then
    base_dir="$(cd "$JINX_SOURCE_DIR" && pwd -P)"
else
    base_dir=/base_dir
fi

JINX_CONFIG_FILE="${base_dir}/Jinxfile"

if [[ -z ${JINX_CACHE_DIR} ]]; then
    JINX_CACHE_DIR="${base_dir}/.jinx-cache"
fi
if [[ ! -d "$(dirname "$JINX_CACHE_DIR")" ]]; then
    die "cannot access cache directory parent"
fi

if [[ ${in_container} == false ]]; then
    # Whatever root creates here, the user who builds could not change later.
    if [[ $(id -u) == 0 && ! -d ${JINX_CACHE_DIR} ]]; then
        die "there is no Jinx cache yet; run any jinx command as the user who builds the packages first"
    fi
    mkdir -p "$JINX_CACHE_DIR"
    JINX_CACHE_DIR="$(cd "$JINX_CACHE_DIR" && pwd -P)"

    export PATH="${JINX_CACHE_DIR}/bin:${JINX_CACHE_DIR}/xbps/bin:${JINX_CACHE_DIR}/debootstrap/usr/sbin:${PATH}:/usr/sbin:/sbin"

    if [[ $(id -u) != 0 ]]; then
        mkdir -p "${base_dir}/sources" "${base_dir}/host-sources" "${build_dir}/host-builds" "${build_dir}/host-pkgs" "${build_dir}/builds" "${build_dir}/pkgs"
    fi

    # flock needs no write access, so hold the lock on a read-only
    # descriptor: a lock file left behind by a run as root ('install' is
    # allowed to be one) still works for every later run.
    if [[ ! -e "${JINX_CACHE_DIR}/jinx.lock" ]]; then
        : >"${JINX_CACHE_DIR}/jinx.lock"
    fi
    exec 9<"${JINX_CACHE_DIR}/jinx.lock"
    if ! flock -n 9; then
        die "another jinx is already running in this build directory.
  lock: ${JINX_CACHE_DIR}/jinx.lock
  jinx shares sources/, builds/ and pkgs/ between runs and is not
  concurrency-safe -- a second run will delete the first one's build tree.
  Wait for the running command to finish."
    fi
fi

apt_cache="$JINX_CACHE_DIR/apt-cache"

if [[ ${in_container} == false ]]; then
    tmp_dir="${JINX_CACHE_DIR}/tmp"
else
    # Where run_in_container mounts the cache's tmp/, wherever the cache is.
    tmp_dir=/jinx-tmp
fi

force_remove() {
    rm -rf "$@" 2>/dev/null && return
    # Only a directory without write or search permission can block deletion,
    # and directories, unlike the files of image sets, are never hard-linked.
    find "$@" -type d ! -perm -700 -exec chmod u+rwx {} + 2>/dev/null || true
    rm -rf "$@"
}

temp_collect=()

cleanup_done=no
cleanup() {
    if [[ ${cleanup_done} == yes ]]; then
        return
    fi
    cleanup_done=yes
    if (( ${#temp_collect[@]} > 0 )); then
        force_remove "${temp_collect[@]}"
    fi
}

trap 'tmp_ret=$?; set +e; cleanup; trap - EXIT; exit ${tmp_ret}' INT TERM HUP QUIT EXIT

make_temp() {
    tmp="$(mktemp ${1-} "${tmp_dir}/tmp.XXXXXXXX")"
    temp_collect+=("${tmp}")
}

tracked_subshell() {
    (
        temp_collect=()
        cleanup_done=no
        trap 'tmp_ret=$?; set +e; cleanup; trap - EXIT; exit ${tmp_ret}' INT TERM HUP QUIT EXIT
        set -e
        eval "$1"
    )
}

include_recipe() {
    if [[ ! -f $1/recipe ]]; then
        printf 'die %q\n' "recipe file '$1/recipe' not found"
        return 1
    fi
    cat <<'EOF'
local cross_compile=
local version=
local revision=
local from_source=
local from_host_source=
local deps=
local binpkgdeps=
local conf_files=
local builddeps=
local hostdeps=
local hostrundeps=
local imagedeps=
local imagerundeps=
local allow_network=
local source_deps=
local source_hostdeps=
local source_imagedeps=
local source_allow_network=
local clean_workdirs=
local bootstrap_pkg=
local source_dir=
local git_url=
local commit=
local shallow=
local tarball_url=
local tarball_sha256=
local tarball_sha512=
local tarball_blake2b=
local zip_url=
local zip_sha256=
local zip_sha512=
local zip_blake2b=
local _archive_format=tar
local _checksum_prefix=tarball

early_prepare() { :; }
prepare() { :; }
configure() { :; }
build() { :; }
package() { :; }
EOF
    printf 'local recipe_dir=%q\n' "$1"
    printf 'local name=%q\n' "$(basename "$1")"
    printf 'local _expected_name=%q\n' "$(basename "$1")"
    printf '. %q/recipe\n' "$1"
    cat <<'EOF'

if [[ ${name} != ${_expected_name} ]]; then
    die "recipe at '${recipe_dir}' must not override 'name' (recipe sets '${name}' but directory is '${_expected_name}'); remove the 'name=' assignment from the recipe"
fi

if [[ -n ${cross_compile} && ${cross_compile} != yes ]]; then
    die "recipe '${name}' sets cross_compile to '${cross_compile}'; it must be 'yes' or unset"
fi

if [[ -n ${tarball_url} && -n ${git_url} ]]; then
    die "recipe '${name}' sets both tarball_url and git_url (mutually exclusive source methods)"
fi

if [[ -n ${source_dir} && -n ${tarball_url} ]]; then
    die "recipe '${name}' sets both source_dir and tarball_url (mutually exclusive source methods)"
fi

if [[ -n ${zip_url} ]]; then
    if [[ -n ${tarball_url} ]]; then
        die "recipe '${name}' sets both tarball_url and zip_url (mutually exclusive source methods)"
    fi
    if [[ -n ${git_url} ]]; then
        die "recipe '${name}' sets both zip_url and git_url (mutually exclusive source methods)"
    fi
    if [[ -n ${source_dir} ]]; then
        die "recipe '${name}' sets both source_dir and zip_url (mutually exclusive source methods)"
    fi
    local tarball_url=${zip_url}
    local tarball_sha256=${zip_sha256}
    local tarball_sha512=${zip_sha512}
    local tarball_blake2b=${zip_blake2b}
    local _archive_format=zip
    local _checksum_prefix=zip
fi

case "${recipe_dir}" in
    "${base_dir}"/host-recipes/*) local _from_source_dir=host-recipes ;;
    *) local _from_source_dir=recipes ;;
esac
if [[ -n ${from_host_source} ]]; then
    if [[ -n ${from_source} ]]; then
        die "recipe '${name}' sets both from_source and from_host_source"
    fi
    local from_source=${from_host_source}
    local _from_source_dir=host-recipes
elif [[ -n ${from_source} ]]; then
    local _from_source_dir=recipes
fi
local _sources_root=${_from_source_dir/recipes/sources}

if [[ -n ${from_source} && ( -n ${tarball_url} || -n ${git_url} || -n ${source_dir} ) ]]; then
    die "recipe '${name}' uses from_source/from_host_source and cannot also have its own source"
fi

if [[ -n ${from_source} && -d ${recipe_dir}/patches ]]; then
    die "recipe '${name}' uses from_source/from_host_source and cannot have its own patches/ directory (patches live with the source recipe)"
fi

if [[ ! ${revision} =~ ^[0-9]+$ ]]; then
    die "recipe '${name}' sets revision to '${revision}'; it must be a non-negative integer"
fi

# xbps splits a package's name from its version at the last '-'. A consumer
# of another recipe's source takes that recipe's version, so has none here.
if [[ -z ${from_source} ]]; then
    if [[ -z ${version} ]]; then
        die "recipe '${name}' sets no version"
    fi
    if [[ ${version} == *-* ]]; then
        die "recipe '${name}' sets version to '${version}'; it must not contain '-'"
    fi
fi
EOF
}

build_hostdeps() {
    local hostdep
    for hostdep in ${hostdeps} ${hostrundeps}; do
        [[ -f "${base_dir}/host-recipes/${hostdep}/recipe" ]] || die "missing host dependency '${hostdep}' for recipe '${name}'"

        tracked_subshell '
            do_host_build_if_needed ${hostdep}
        '
    done
}

build_deps() {
    local dep
    for dep in ${deps} ${builddeps}; do
        [[ -f "${base_dir}/recipes/${dep}/recipe" ]] || die "missing dependency '${dep}' for recipe '${name}'"

        tracked_subshell '
            do_update yes ${dep}
        '
    done
}

get_hostdeps_file() {
    local deps_to_do=""

    local hostdep
    for hostdep in ${hostdeps} ${hostrundeps}; do
        if [[ -z ${_hostdeps_collected[$hostdep]+x} ]]; then
            local deps_to_do="${deps_to_do} ${hostdep}"
            _hostdeps_collected[$hostdep]=1
        fi
    done

    for hostdep in ${deps_to_do}; do
        eval "$(include_recipe "${base_dir}"/host-recipes/${hostdep})"
        get_hostdeps_file
    done
}

topo_sort_visit() {
    [[ -n ${_visited[$1]+x} ]] && return
    _visited[$1]=1

    local _dep
    for _dep in ${_graph[$1]}; do
        [[ -n $_dep ]] && topo_sort_visit "$_dep"
    done

    _result="${_result}$1 "
}

topo_sort() {
    local -A _graph
    local -A _visited
    local _result=

    local _node _deps
    while IFS=: read -r _node _deps; do
        [[ -z $_node ]] && continue
        # first occurrence wins
        [[ -n ${_graph[$_node]+x} ]] || _graph[$_node]=$_deps
    done <<<"$1"

    for _node in $(printf '%s\n' "${!_graph[@]}" | sort); do
        topo_sort_visit "$_node"
    done

    echo "${_result% }"
}

get_builddeps() {
    local pkg="$1"

    eval "$(include_recipe "${base_dir}/recipes/${pkg}")"

    local -A _deps_collected

    get_builddeps_file

    local graph="${pkg}:${deps} ${builddeps}"

    local dep
    for dep in "${!_deps_collected[@]}"; do
        if [[ ! -f "${base_dir}/recipes/${dep}/recipe" ]]; then
            die "dependency '${dep}' for recipe '${pkg}' not found"
        fi

        local graph="${graph}
${dep}:$(eval "$(include_recipe "${base_dir}/recipes/${dep}")" && echo ${deps})"
    done

    topo_sort "${graph}"
}

get_source_deps() {
    # Source-level deps of recipe $1 in $2, as '<source_hostdeps>|<source_deps>'.
    # A recipe using from_source/from_host_source borrows them from the recipe
    # owning the source; source_hostdeps always resolve in host-recipes/ and
    # source_deps in recipes/, whichever namespace the source recipe lives in.
    (
        eval "$(include_recipe "${base_dir}/$2/$1")"

        if [[ -n ${from_source} ]]; then
            eval "$(include_recipe "${base_dir}/${_from_source_dir}/${from_source}")"
        fi

        echo "${source_hostdeps}|${source_deps}"
    )
}

get_builddeps_file() {
    local deps_to_do=""

    local dep
    for dep in ${deps} ${builddeps}; do
        if [[ -z ${_deps_collected[$dep]+x} ]]; then
            local deps_to_do="${deps_to_do} ${dep}"
            _deps_collected[$dep]=1
        fi
    done

    for dep in ${deps_to_do}; do
        eval "$(include_recipe "${base_dir}"/recipes/${dep})"
        get_deps_file
    done
}

get_deps_file() {
    local deps_to_do=""

    local dep
    for dep in ${deps}; do
        if [[ -z ${_deps_collected[$dep]+x} ]]; then
            local deps_to_do="${deps_to_do} ${dep}"
            _deps_collected[$dep]=1
        fi
    done

    for dep in ${deps_to_do}; do
        eval "$(include_recipe "${base_dir}"/recipes/${dep})"
        get_deps_file
    done
}

run_in_container1() {
    local run_in_cont1_root="$1"
    shift 1

    cat /etc/resolv.conf >"${run_in_cont1_root}/etc/resolv.conf"

    local arg
    unshare --user --map-root-user --mount --pid --fork -- "$BASH" -c "
        set -e

        mount --rbind --make-rslave /dev '${run_in_cont1_root}/dev'
        mount -t proc proc '${run_in_cont1_root}/proc'
        mount --rbind --make-rslave /sys '${run_in_cont1_root}/sys'
        mount -t tmpfs run '${run_in_cont1_root}/run'
        mount -t tmpfs tmpfs '${run_in_cont1_root}/tmp'
        mount -t tmpfs tmpfs '${run_in_cont1_root}/var/tmp'

        mount --bind '${apt_cache}' '${run_in_cont1_root}/var/cache/apt/archives'

        env -i PATH='${PATH}' chroot '${run_in_cont1_root}' /bin/sh -c '
            set -e

            LD_PRELOAD=/nochown.so \
            HOME=/root \
            LANG=en_US.UTF-8 \
            LC_COLLATE=C \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin \
            LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib:/usr/lib64:/usr/lib \
            DEBIAN_FRONTEND=noninteractive \
            $(for arg in "$@"; do printf '"%s" \\\n' "${arg//\"/\\\"}"; done)
            # keep this whitespace
        '
    "

    rm "${run_in_cont1_root}/etc/resolv.conf"
}

prepare_container() {
    cd "${build_dir}"

    local -A _hostdeps_collected
    local -A _deps_collected

    build_hostdeps
    build_deps

    get_hostdeps_file
    get_builddeps_file

    local _bpd_of _bpd
    for _bpd_of in "${!_deps_collected[@]}"; do
        for _bpd in $(eval "$(include_recipe "${base_dir}/recipes/${_bpd_of}")" && echo "${binpkgdeps}"); do
            [[ -n ${_deps_collected[$_bpd]+x} ]] && continue
            [[ ${_bpd} == "${name}" ]] && continue
            tracked_subshell '
                do_build_if_needed "${_bpd}"
            '
        done
    done

    make_temp -d
    sysroot="${tmp}"

    make_temp
    local xbps_log="${tmp}"
    local dep
    for dep in "${!_deps_collected[@]}"; do
        XBPS_ARCH=invalid \
        XBPS_TARGET_ARCH="${JINX_ARCH}" \
            xbps-install -y -r "${sysroot}" -R "${build_dir}"/pkgs "${dep}" >"${xbps_log}" 2>&1 \
            || { error "failed to install '${dep}' into the sysroot:"; sed 's/^/    /' "${xbps_log}" >&2; exit 17; }
    done

    if [[ $JINX_NATIVE_MODE == yes && -z $cross_compile ]]; then
        imgroot="${sysroot}"
    else
        make_temp -d
        local host_root="${tmp}"
        local hostdep
        for hostdep in "${!_hostdeps_collected[@]}"; do
            XBPS_ARCH=invalid \
            XBPS_TARGET_ARCH="${host_arch}" \
                xbps-install -y -r "${host_root}" -R "${build_dir}"/host-pkgs "${hostdep}" >"${xbps_log}" 2>&1 \
                || { error "failed to install host package '${hostdep}':"; sed 's/^/    /' "${xbps_log}" >&2; exit 17; }
        done
        container_pkgs="${host_root}/usr/local"
        mkdir -p "${container_pkgs}"

        local _imagerundep
        case "${recipe_dir}" in
            # A host recipe's own imagerundeps go into its own build image too,
            # mirroring how its own hostrundeps are installed into its own
            # container: a host build routinely runs what it just built.
            "${base_dir}"/host-recipes/*)
                for _imagerundep in ${imagerundeps}; do
                    imagedeps="${imagedeps} ${_imagerundep}"
                done
                ;;
        esac
        for hostdep in "${!_hostdeps_collected[@]}"; do
            for _imagerundep in $(eval "$(include_recipe "${base_dir}/host-recipes/${hostdep}")" && echo "${imagerundeps}"); do
                imagedeps="${imagedeps} ${_imagerundep}"
            done
        done

        imagedeps="$(echo "${imagedeps}" | xargs -n1 | sort -u | xargs)"

        local pkgset=""
        local pkg
        for pkg in ${imagedeps}; do
            local pkgset="${pkgset}${pkg}/"

            if [[ -f "$JINX_CACHE_DIR/sets/${pkgset}.image/.jinx-set-valid" ]]; then
                continue
            fi

            force_remove "$JINX_CACHE_DIR/sets/${pkgset}"
            mkdir -p "$JINX_CACHE_DIR/sets/${pkgset}"

            cp -Pplrf "$JINX_CACHE_DIR/sets/${pkgset}../.image" "$JINX_CACHE_DIR/sets/${pkgset}.image"

            rm -f "$JINX_CACHE_DIR/sets/${pkgset}.image/.jinx-set-valid"

            run_in_container1 "$JINX_CACHE_DIR/sets/${pkgset}.image" apt-get install -y "${pkg}"

            # Fix permissions of files
            find "$JINX_CACHE_DIR/sets/${pkgset}.image" -perm 000 -exec chmod 755 {} + 2>/dev/null

            touch "$JINX_CACHE_DIR/sets/${pkgset}.image/.jinx-set-valid"
        done

        imgroot="$JINX_CACHE_DIR/sets/${pkgset}.image"
    fi
}

# The commands that bind-mount $1 onto $2, read-only if $3 is non-empty. The
# separate remount is what makes it read-only: busybox's mount ignores ro when
# it creates a bind mount.
bind_mount_cmd() {
    printf "mount --bind '%s' '%s'\n" "$1" "$2"
    if [[ -n ${3-} ]]; then
        printf "mount -o remount,bind,ro '%s'\n" "$2"
    fi
}

run_in_container() {
    if [[ ${allow_network} == yes ]]; then
        local unshare_net_flag=""
    else
        local unshare_net_flag="--net"
    fi

    local run_in_cont_term=
    if [[ -n $TERM ]]; then
        local run_in_cont_term="TERM=\"$TERM\""
    fi

    local run_in_cont_colorterm=
    if [[ -n $COLORTERM ]]; then
        local run_in_cont_colorterm="COLORTERM=\"$COLORTERM\""
    fi

    local run_in_cont_no_color=
    if [[ -n ${NO_COLOR-} ]]; then
        local run_in_cont_no_color="NO_COLOR=1"
    fi

    mkdir -p "${imgroot}/base_dir" "${imgroot}/build_dir" "${imgroot}/jinx-tmp"
    cat /etc/resolv.conf >"${imgroot}/etc/resolv.conf"
    touch "${imgroot}/jinx"

    local container_pkgs_native_mount=""
    local sysroot_native_mount=""
    if [[ ($JINX_NATIVE_MODE == yes && $cross_compile == yes) || $JINX_NATIVE_MODE != yes ]]; then
        mkdir -p "${imgroot}/sysroot"

        local container_pkgs_native_mount="$(bind_mount_cmd "${container_pkgs}" "${imgroot}/usr/local" ro)"
        local sysroot_native_mount="$(bind_mount_cmd "${sysroot}" "${imgroot}/sysroot" ro)"

        local run_in_cont_lang=en_US.UTF-8
    else
        if [[ -n $JINX_NATIVE_LANG ]]; then
            local run_in_cont_lang="$JINX_NATIVE_LANG"
        else
            local run_in_cont_lang=C
        fi
    fi

    local shadow_git_dir_build=""
    if [[ -d "${build_dir}/.git" ]]; then
        make_temp -d
        local shadow_git_dir_build="mount --bind '${tmp}' '${imgroot}/build_dir/.git'"
    fi

    local shadow_git_dir_base=""
    if [[ -d "${base_dir}/.git" ]]; then
        make_temp -d
        local shadow_git_dir_base="mount --bind '${tmp}' '${imgroot}/base_dir/.git'"
    fi

    local arg

    # Recomputed per step so the memory cap tracks the RAM free right now.
    local parallelism="$(compute_parallelism)"

    unshare --user --map-root-user --mount --pid --fork ${unshare_net_flag} -- "$BASH" -c "
        set -e

        $(bind_mount_cmd "${imgroot}" "${imgroot}" ro)

        mount --rbind --make-rslave /dev '${imgroot}/dev'
        mount -t proc proc '${imgroot}/proc'
        mount --rbind --make-rslave /sys '${imgroot}/sys'
        mount -t tmpfs run '${imgroot}/run'
        mount -t tmpfs tmpfs '${imgroot}/tmp'
        mount -t tmpfs tmpfs '${imgroot}/var/tmp'

        $(bind_mount_cmd "${script}" "${imgroot}/jinx" ro)
        $(bind_mount_cmd "${base_dir}" "${imgroot}/base_dir" "${container_base_dir_ro}")
        mount --bind '${tmp_dir}' '${imgroot}/jinx-tmp'
        mount --bind '${build_dir}' '${imgroot}/build_dir'
        $(bind_mount_cmd "${base_dir}/sources" "${imgroot}/base_dir/sources" "${container_sources_ro}")
        $(bind_mount_cmd "${base_dir}/host-sources" "${imgroot}/base_dir/host-sources" "${container_sources_ro}")
        ${container_pkgs_native_mount}
        ${sysroot_native_mount}
        ${shadow_git_dir_base}
        ${shadow_git_dir_build}

        env -i PATH='${PATH}' chroot '${imgroot}' /bin/sh -c '
            set -e

            cd /build_dir

            LD_PRELOAD=/nochown.so \
            HOME=/root \
            LANG=${run_in_cont_lang} \
            LC_COLLATE=C \
            PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin \
            LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib:/usr/lib64:/usr/lib \
            ${run_in_cont_term} \
            ${run_in_cont_colorterm} \
            ${run_in_cont_no_color} \
            JINX_PARALLELISM=${parallelism} \
            /bin/bash /jinx \
            $(for arg in "$@"; do printf '"%s" \\\n' "${arg//\"/\\\"}"; done)
            # keep this whitespace
        '
    "

    force_remove "${imgroot}/sysroot" "${imgroot}/base_dir" "${imgroot}/build_dir" "${imgroot}/jinx-tmp" "${imgroot}/jinx"
    rm "${imgroot}/etc/resolv.conf"
}

destroy_container() {
    # Native builds have no separate host packages.
    force_remove ${container_pkgs:+"${container_pkgs}"} "${sysroot}"
}

do_git_fetch() {
    # $1: clone destination (default: the recipe's sources/ slot).
    # $2: "full" forces a full clone regardless of the shallow property.
    local _dest="${1:-${base_dir}/${_sources_root}/${name}}"
    local _force_full="${2:-}"

    if [[ -z ${commit} ]]; then
        die "recipe '${name}' sets git_url but no commit"
    fi

    if [[ ! ${commit} =~ ^[0-9a-f]{40}$ ]]; then
        die "recipe '${name}': commit '${commit}' is not a full, lowercase commit hash"
    fi

    if [[ ${shallow} == no || ${_force_full} == full ]]; then
        git clone "${git_url}" "${_dest}"
        git -C "${_dest}" -c advice.detachedHead=false checkout "${commit}"
    else
        git clone "${git_url}" -c advice.detachedHead=false --revision="${commit}" --depth=1 "${_dest}"
    fi
}

do_tarball_fetch() {
    local tarball_path="${base_dir}/${_sources_root}/$(basename "${tarball_url}")"

    if [[ ! -f $tarball_path ]]; then
        make_temp
        local download_path="${tmp}"

        curl -f -L -o "${download_path}" "${tarball_url}"
        mv "${download_path}" "${tarball_path}"
    fi

    local checksum_verified=no

    fill_recipe_checksum() {
        local var_name="$1"
        local checksum_value="$2"
        if [[ -n ${current_recipe_file} && -f ${current_recipe_file} ]]; then
            # Replace the first `var=?`, `var="?"` or `var='?'` placeholder,
            # preserving indentation and quoting style.
            local _re='^([[:space:]]*)'"${var_name}"'=("?|'\''?)[?]("?|'\''?)([[:space:]]*)$'
            make_temp
            local _out="${tmp}"
            local _done=no
            local line
            while IFS= read -r line || [[ -n ${line} ]]; do
                if [[ ${_done} == no && ${line} =~ $_re ]]; then
                    local line="${BASH_REMATCH[1]}${var_name}=${BASH_REMATCH[2]}${checksum_value}${BASH_REMATCH[3]}${BASH_REMATCH[4]}"
                    local _done=yes
                fi
                printf '%s\n' "${line}"
            done <"${current_recipe_file}" >"${_out}"
            # Left as it is, the '?' would let every later fetch through
            # unverified.
            if [[ ${_done} == no ]]; then
                die "cannot autofill ${var_name} for ${name}: no ${var_name}=? line in ${current_recipe_file}"
            fi
            mv "${_out}" "${current_recipe_file}"
        else
            die "cannot autofill ${var_name} for ${name}: recipe file unknown"
        fi
    }

    if [[ -n ${tarball_sha256} ]]; then
        local actual_sha256="$(sha256sum "${tarball_path}")"
        local actual_sha256="${actual_sha256%% *}"
        if [[ ${actual_sha256} != "${tarball_sha256}" ]]; then
            if [[ ${tarball_sha256} == "?" ]]; then
                fill_recipe_checksum "${_checksum_prefix}_sha256" "${actual_sha256}"
            else
                die "failed to verify the SHA256 of ${name}'s source:
  expected '${tarball_sha256}'
  got      '${actual_sha256}'"
            fi
        fi
        local checksum_verified=yes
    fi
    if [[ -n ${tarball_sha512} ]]; then
        local actual_sha512="$(sha512sum "${tarball_path}")"
        local actual_sha512="${actual_sha512%% *}"
        if [[ ${actual_sha512} != "${tarball_sha512}" ]]; then
            if [[ ${tarball_sha512} == "?" ]]; then
                fill_recipe_checksum "${_checksum_prefix}_sha512" "${actual_sha512}"
            else
                die "failed to verify the SHA512 of ${name}'s source:
  expected '${tarball_sha512}'
  got      '${actual_sha512}'"
            fi
        fi
        local checksum_verified=yes
    fi
    if [[ -n ${tarball_blake2b} ]]; then
        local actual_blake2b="$(b2sum "${tarball_path}")"
        local actual_blake2b="${actual_blake2b%% *}"
        if [[ ${actual_blake2b} != "${tarball_blake2b}" ]]; then
            if [[ ${tarball_blake2b} == "?" ]]; then
                fill_recipe_checksum "${_checksum_prefix}_blake2b" "${actual_blake2b}"
            else
                die "failed to verify the BLAKE2B of ${name}'s source:
  expected '${tarball_blake2b}'
  got      '${actual_blake2b}'"
            fi
        fi
        local checksum_verified=yes
    fi

    if [[ ${checksum_verified} == no ]]; then
        die "recipe '${name}' sets no checksum for its archive"
    fi

    make_temp -d
    local extract_dir="${tmp}"

    if [[ ${_archive_format} == zip ]]; then
        ( cd "${extract_dir}" && unzip -q "${tarball_path}" )
    else
        ( cd "${extract_dir}" && tar -xf "${tarball_path}" )
    fi

    mv "${extract_dir}"/* "${base_dir}"/${_sources_root}/${name} >/dev/null 2>&1 || (
        mkdir -p "${base_dir}"/${_sources_root}/${name}
        mv "${extract_dir}"/* "${base_dir}"/${_sources_root}/${name}/
    )

    force_remove "${extract_dir}" "${tarball_path}"
}

get_real_source_dir() {
    if [[ -z ${source_dir} && -z ${git_url} && -z ${tarball_url} ]]; then
        cat <<'EOF'
local source_dir=/dev/null
local is_local_package=true
local is_sourceless_package=true
EOF
        return
    fi

    cat <<'EOF'
local is_sourceless_package=
EOF

    if [[ -z ${source_dir} ]]; then
        cat <<'EOF'
local is_local_package=
EOF
        printf 'local source_dir=%q\n' "${base_dir}/${_sources_root}/${name}"
    else
        local _real_path="${base_dir}/${source_dir}"
        # A managed clone (git_url also set) may not exist yet; it gets cloned on
        # first fetch. A plain local package's source_dir must already exist.
        if [[ -z ${git_url} && ! -d ${_real_path} ]]; then
            printf 'die %q\n' "recipe '${name}': source_dir '${source_dir}' does not exist"
            return 1
        fi
        cat <<'EOF'
local is_local_package=true
EOF
        printf 'local source_dir=%q\n' "${_real_path}"
    fi
}

source_source_recipe() {
    local name="$1"
    local dir="$2"
    local _path="${base_dir}/${dir}/${name}"
    if [[ ! -f $_path/recipe ]]; then
        printf 'die %q\n' "could not find recipe '${name}' in ${dir}/"
        return 1
    fi
    printf 'local current_recipe_file=%q\n' "${_path}/recipe"
    include_recipe "${_path}"

    cat <<'EOF'
local imagedeps="${source_imagedeps}"
local hostdeps="${source_hostdeps}"
local deps="${source_deps}"
local allow_network="${source_allow_network}"
local builddeps=
local hostrundeps=
local imagerundeps=
local binpkgdeps=
EOF
}

do_fetch() {
    eval "$(source_source_recipe "$1" "$2")"

    eval "$(get_real_source_dir)"

    local sysroot=/sysroot

    if [[ ${is_local_package} == true ]]; then
        # Managed clone: a local package with a git_url is cloned into source_dir
        # once and then used in place. An existing tree is never re-cloned (remove
        # it to start fresh); plain local and sourceless packages have no git_url.
        if [[ -n ${git_url} && ! -d ${source_dir} ]]; then
            do_git_fetch "${source_dir}" full
        fi
    else
        if [[ -n ${git_url} ]]; then
            do_git_fetch
        elif [[ -n ${tarball_url} ]]; then
            do_tarball_fetch
        fi
    fi

    if [[ ${is_sourceless_package} != true ]]; then
        tracked_subshell '
            cd "${source_dir}"
            early_prepare
        '
    fi
}

do_patch() {
    eval "$(source_source_recipe "$1" "$2")"

    eval "$(get_real_source_dir)"

    make_temp
    local patch_trash="${tmp}"

    cd "${source_dir}"

    local _patches_dir="${base_dir}/${_from_source_dir}/${name}/patches"
    local needs_match_timestamps=no
    force_remove "${base_dir}/${_sources_root}/${name}-clean"
    if [[ -d ${_patches_dir} ]]; then
        local patch
        for patch in "${_patches_dir}"/*; do
            [[ ${patch} == "${_patches_dir}/*" ]] && break
            [[ ${patch} == "${_patches_dir}/jinx-working-patch.patch" ]] && continue

            if [[ ! -d "${base_dir}/${_sources_root}/${name}-clean" ]]; then
                cp -rp "${source_dir}" "${base_dir}/${_sources_root}/${name}-clean"
                local needs_match_timestamps=yes
            fi

            patch --no-backup-if-mismatch -p1 -r "${patch_trash}" < "${patch}"
        done

        if [[ ${needs_match_timestamps} == yes ]]; then
            # make sure timestamps match
            local f
            for f in $(diff -rq --no-dereference "${base_dir}/${_sources_root}/${name}-clean" "${source_dir}" | sed '/^Only in/d;s/^Files //g;s/ and.*$//g'); do
                touch --reference="$f" "${f//${_sources_root}\/${name}-clean/${_sources_root}\/${name}}"
            done
            force_remove "${base_dir}/${_sources_root}/${name}-clean"
        fi
    fi

    cp -rp "${source_dir}" "${base_dir}/${_sources_root}/${name}-clean"

    if [[ -f "${_patches_dir}/jinx-working-patch.patch" ]]; then
        patch --no-backup-if-mismatch -p1 -r "${patch_trash}" < "${_patches_dir}/jinx-working-patch.patch"

        # make sure timestamps match
        local f
        for f in $(diff -rq --no-dereference "${base_dir}"/${_sources_root}/${name}-clean "${source_dir}" | sed '/^Only in/d;s/^Files //g;s/ and.*$//g'); do
            touch --reference="$f" "${f//${_sources_root}\/${name}-clean/${_sources_root}\/${name}}"
        done
    fi

    cp -rp "${source_dir}" "${base_dir}"/${_sources_root}/${name}-workdir

    cd "${base_dir}"
}

do_prepare() {
    eval "$(source_source_recipe "$1" "$2")"

    eval "$(get_real_source_dir)"

    local sysroot=/sysroot

    cd "${source_dir}"
    prepare
    cd "${base_dir}"
}

do_configure_host() {
